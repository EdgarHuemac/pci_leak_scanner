[
  {
    "rule_code": "PCI_FIN_0001",
    "description": "Detection of Primary Account Numbers (PAN) \u2014 Credit/Debit Cards, including spaced/hyphenated forms, additional schemes (UnionPay, Maestro, Mir, Troy), and field-labeled PANs.",
    "mitigation": "PCI DSS 4.0 Req. 3.4.1 / 3.5.1: render PAN unreadable anywhere it is stored (strong cryptography, truncation, tokenization, or hashing). Mask in logs to at most first 6 + last 4. Never persist full PAN in application logs, debug dumps, APM traces, crash reports, or analytics. Prefer a payment vault / tokenization service so PAN never reaches your log pipeline.",
    "patterns": [
      {
        "name": "Visa (13/16/19 digits, contiguous)",
        "regex": "\\b4[0-9]{12}(?:[0-9]{3})?(?:[0-9]{3})?\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Visa (spaced or hyphenated 4-4-4-4)",
        "regex": "\\b4[0-9]{3}(?:[\\s\\-][0-9]{4}){3}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Mastercard (51-55 and 2221-2720, contiguous)",
        "regex": "\\b(?:5[1-5][0-9]{2}|222[1-9]|22[3-9][0-9]|2[3-6][0-9]{2}|27[01][0-9]|2720)[0-9]{12}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Mastercard (spaced or hyphenated)",
        "regex": "\\b(?:5[1-5][0-9]{2}|222[1-9]|22[3-9][0-9]|2[3-6][0-9]{2}|27[01][0-9]|2720)(?:[\\s\\-][0-9]{4}){3}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "American Express (contiguous 15-digit)",
        "regex": "\\b3[47][0-9]{13}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "American Express (spaced/hyphenated 4-6-5)",
        "regex": "\\b3[47][0-9]{2}[\\s\\-][0-9]{6}[\\s\\-][0-9]{5}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Discover (6011, 644-649, 65)",
        "regex": "\\b6(?:011|4[4-9][0-9]|5[0-9]{2})[0-9]{12}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Discover (spaced or hyphenated)",
        "regex": "\\b6(?:011|4[4-9][0-9]|5[0-9]{2})(?:[\\s\\-][0-9]{4}){3}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Diners Club / Carte Blanche (14-digit)",
        "regex": "\\b3(?:0[0-5]|[689][0-9])[0-9]{11}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "JCB 15-digit (2131 / 1800)",
        "regex": "\\b(?:2131|1800)[0-9]{11}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "JCB 16-digit (3528-3589)",
        "regex": "\\b35[2-8][0-9]{13}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "China UnionPay (16-19 digits, BIN 62)",
        "regex": "\\b62[0-9]{14,17}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Maestro (common BINs, 12-19 digits)",
        "regex": "\\b(?:5018|5020|5038|5893|6304|6759|6761|6762|6763)[0-9]{8,15}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Mir (BIN 2200-2204)",
        "regex": "\\b220[0-4][0-9]{12}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Troy (BIN 9792)",
        "regex": "\\b9792[0-9]{12}\\b",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Field-labeled PAN (pan=, card_number=, cc_num=, ...)",
        "regex": "(?i)\\b(?:pan|primary[_-]?account(?:[_-]?number)?|card[_-]?(?:number|no)|cc[_-]?n(?:um(?:ber)?)?|acct[_-]?num(?:ber)?|account[_-]?number)\\b[\\s=:\\\"']+([0-9]{13,19}|[0-9]{4}(?:[\\s\\-][0-9]{4}){3}|3[47][0-9]{2}[\\s\\-][0-9]{6}[\\s\\-][0-9]{5})",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "JSON/XML-style PAN field",
        "regex": "(?i)[\\\"'<](?:pan|cardNumber|card_number|card-number|primaryAccountNumber|accountNumber|ccNumber|cc_number|PrimaryAccountNumber)[\\\"'>][\\s:=]+[\\\"']?[0-9][0-9\\s\\-]{11,21}[0-9]",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "Spaced/hyphenated 16-digit grouping (possible PAN)",
        "regex": "\\b[0-9]{4}(?:[\\s\\-][0-9]{4}){3}\\b",
        "confidence": "Medium",
        "validate_luhn": true
      },
      {
        "name": "Over-displayed truncated PAN (more than first 6 + last 4)",
        "regex": "\\b[0-9]{8,12}[*xX\u2022]{2,8}[0-9]{4}\\b",
        "confidence": "Medium",
        "validate_luhn": false
      },
      {
        "name": "PAN in query string",
        "regex": "(?i)[?&](?:card(?:[_-]?number)?|pan|cc|ccnum)=([0-9]{13,19})",
        "confidence": "High",
        "validate_luhn": true
      },
      {
        "name": "JSON generic number field (Stripe/Braintree-style)",
        "regex": "(?i)[\\\"']number[\\\"']\\s*:\\s*[\\\"'][0-9]{13,19}[\\\"']",
        "confidence": "Medium",
        "validate_luhn": true
      }
    ]
  },
  {
    "rule_code": "PCI_FIN_0002",
    "description": "Detection of Card Verification Values (CVV/CVC/CVV2/CID/CAV2/CSC) in logs and structured payloads.",
    "mitigation": "PCI DSS 4.0 Req. 3.3.1: SAD (including CAV2/CVC2/CVV2/CID) must NEVER be stored after authorization, even if encrypted. Strip CVV at the edge (payment processor / vault), disable CVV fields in debug/request logging, and audit APM body capture. Rotate any processor credentials if CVV leakage is confirmed.",
    "patterns": [
      {
        "name": "CVV/CVC/CID/CAV/CSC assignment (3-4 digits)",
        "regex": "(?i)\\b(?:cvv2?|cvc2?|cid|cav2?|csc|cvn2?|security[_-]?code|card[_-]?security[_-]?code|card[_-]?code)\\b[\\s=:\\\"']+(\\d{3,4})\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "JSON CVV/CVC/CID field",
        "regex": "(?i)[\\\"'](?:cvv2?|cvc2?|cid|cav2?|csc|cvn2?|securityCode|security_code|cardCode|card_code)[\\\"']\\s*:\\s*[\\\"']?\\d{3,4}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "XML CVV/CVC element",
        "regex": "(?i)<(?:cvv2?|cvc2?|cid|cav2?|csc|cvn2?|securityCode|cardCode)>\\s*\\d{3,4}\\s*<",
        "confidence": "High",
        "validate_luhn": false
      }
    ]
  }
]
