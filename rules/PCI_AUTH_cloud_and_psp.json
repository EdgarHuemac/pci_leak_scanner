[
  {
    "rule_code": "PCI_AUTH_0003",
    "description": "Detection of cloud, Git, chat, and SaaS credentials commonly leaked into CDE logs and repos.",
    "mitigation": "Revoke and rotate immediately. These keys often grant production deploy, source, or messaging access adjacent to the CDE. PCI DSS 4.0 Req. 8.6 (application secrets not hard-coded) and Req. 6.2.4 (public-facing web / CI). Store in a secret manager; add provider-specific secret scanning.",
    "patterns": [
      {
        "name": "GitLab personal / deploy / runner token",
        "regex": "\\bgl(?:pat|dt|rt|cbt|ptt)-[A-Za-z0-9\\-_]{20,}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Slack bot / user / workspace token",
        "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Slack app-level token",
        "regex": "\\bxapp-[0-9]+-[A-Za-z0-9-]+\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Slack incoming webhook URL",
        "regex": "https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Google API key (AIza...)",
        "regex": "\\bAIza[0-9A-Za-z\\-_]{35}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Google OAuth access token (ya29.)",
        "regex": "\\bya29\\.[0-9A-Za-z\\-_]{20,}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "GCP / Google service account private_key_id",
        "regex": "(?i)[\\\"']private_key_id[\\\"']\\s*:\\s*[\\\"'][0-9a-f]{8,}",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Azure storage AccountKey",
        "regex": "(?i)(?:AccountKey|SharedKey)[=:\\s]+[A-Za-z0-9+/=]{80,}",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Azure SAS signature",
        "regex": "(?i)[?&]sig=[A-Za-z0-9%+/=]{20,}.*[?&]sv=",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "npm access token",
        "regex": "\\bnpm_[A-Za-z0-9]{36}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "PyPI token",
        "regex": "\\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9\\-_]{20,}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "SendGrid API key",
        "regex": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Twilio Account SID / API key SID",
        "regex": "\\b(?:AC|SK)[0-9a-f]{32}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "OpenAI / compatible project key",
        "regex": "\\bsk-(?:proj|svcacct)-[A-Za-z0-9_-]{20,}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Anthropic API key",
        "regex": "\\bsk-ant-[A-Za-z0-9\\-_]{20,}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Hugging Face token",
        "regex": "\\bhf_[A-Za-z0-9]{20,}\\b",
