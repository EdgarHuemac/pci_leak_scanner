        "validate_luhn": false
      },
      {
        "name": "Checkout.com secret / public key",
        "regex": "\\b(?:sk|pk)_(?:sbox_)?[a-zA-Z0-9]{26,}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Authorize.Net transaction key assignment",
        "regex": "(?i)\\b(?:transaction[_-]?key|authnet[_-]?key|authorizenet[_-]?key)\\b[\\s=:\\\"']+[A-Za-z0-9]{16,}",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Braintree private key assignment",
        "regex": "(?i)\\b(?:braintree[_-]?(?:private[_-]?key|merchant[_-]?id)|bt[_-]?private[_-]?key)\\b[\\s=:\\\"']+\\S+",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Worldpay / FIS / CyberSource key assignment",
        "regex": "(?i)\\b(?:cybersource[_-]?(?:key|secret|merchant)|worldpay[_-]?(?:user|xml[_-]?password)|merchant[_-]?secret[_-]?key)\\b[\\s=:\\\"']+\\S+",
        "confidence": "Critical",
        "validate_luhn": false
      }
    ]
  }
