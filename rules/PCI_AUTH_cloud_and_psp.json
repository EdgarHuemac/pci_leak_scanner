        "validate_luhn": false
      },
      {
        "name": "DigitalOcean PAT",
        "regex": "\\bdop_v1_[a-f0-9]{64}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Telegram bot token",
        "regex": "\\b[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Sentry DSN with key",
        "regex": "https://[0-9a-f]{32}@[A-Za-z0-9.-]+\\.ingest(?:\\.de|\\.us)?\\.sentry\\.io/\\d+",
        "confidence": "High",
        "validate_luhn": false
      }
    ]
  },
  {
    "rule_code": "PCI_AUTH_0004",
    "description": "Detection of payment-processor and PSP credentials (beyond Stripe) that grant access to cardholder-data environments.",
    "mitigation": "These keys are CDE credentials. Rotate via the PSP dashboard, review processed transactions for fraud, and treat exposure as a potential PCI incident. PCI DSS 4.0 Req. 8.6.1 (secrets not in source/logs) and Req. 12.10 if account data may have been accessed.",
    "patterns": [
      {
        "name": "Square access token / secret",
        "regex": "\\bsq0(?:atp|csp|idp|csp)-[A-Za-z0-9\\-_]{16,}\\b",
