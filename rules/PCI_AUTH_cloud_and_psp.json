        "validate_luhn": false
      },
      {
        "name": "Square production token (EAAA prefix)",
        "regex": "\\bEAAA[A-Za-z0-9]{32,}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "PayPal / Braintree access token",
        "regex": "\\baccess_token\\$(?:production|sandbox)\\$[A-Za-z0-9\\-_/]{20,}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Shopify Admin / private / custom app token",
        "regex": "\\bshp(?:at|ca|pa|ss)_[A-Za-z0-9]{20,}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Plaid access token",
        "regex": "\\baccess-(?:sandbox|development|production)-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Adyen API key (AQE prefix, common live/test)",
        "regex": "\\bAQE[A-Za-z0-9]{20,}\\b",
