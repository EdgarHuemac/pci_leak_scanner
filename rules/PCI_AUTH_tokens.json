[
  {
    "rule_code": "PCI_AUTH_0001",
    "description": "Detection of authentication tokens, API keys, and cloud access credentials that can unlock CDE systems or payment processors.",
    "mitigation": "PCI DSS 4.0 Req. 8.3 / 8.6 / 6.2: rotate the leaked credential immediately, revoke sessions, and move secrets to a vault (HashiCorp Vault, AWS Secrets Manager, GCP Secret Manager, Azure Key Vault). Never log Authorization headers, JWTs, or env dumps. Add secret scanning to CI and pre-commit.",
    "patterns": [
      {
        "name": "Bearer Token in Authorization header",
        "regex": "(?i)\\bAuthorization[:\\s]+Bearer\\s+(?!(?:masked|redacted|xxx+|placeholder|removed|n/?a)\\b)[A-Za-z0-9\\-._~+/]+=*",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "HTTP Basic Authorization header (base64)",
        "regex": "(?i)\\bAuthorization[:\\s]+Basic\\s+(?!(?:masked|redacted|xxx+)\\b)[A-Za-z0-9+/]{12,}={0,2}",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "JWT Token",
        "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Generic API Key / access token / secret key assignment",
        "regex": "(?i)(?:api[_-]?key|apikey|access[_-]?token|secret[_-]?key|private[_-]?key|client[_-]?secret|app[_-]?secret)[\\s=:\\\"']+[A-Za-z0-9\\-._]{16,}",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "AWS Access Key ID (AKIA/ASIA/AROA/AIDA)",
        "regex": "(?<![A-Z0-9])(AKIA|ASIA|AROA|AIDA)[A-Z0-9]{16}(?![A-Z0-9])",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "AWS Secret Access Key assignment",
        "regex": "(?i)(?:aws[_-]?secret(?:[_-]?access)?[_-]?key|secret[_-]?access[_-]?key)[\\s=:\\\"']+[A-Za-z0-9/+=]{40}",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "GitHub classic PAT (ghp_)",
        "regex": "\\bghp_[A-Za-z0-9]{36}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "GitHub fine-grained PAT (github_pat_)",
        "regex": "\\bgithub_pat_[A-Za-z0-9]{22}_[A-Za-z0-9]{59}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "GitHub OAuth / App / refresh / server token",
        "regex": "\\bgh[ours]_[A-Za-z0-9]{36}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Stripe secret / restricted / publishable key",
        "regex": "\\b(?:sk|pk|rk)_(?:live|test)_[A-Za-z0-9]{16,}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Stripe webhook signing secret",
        "regex": "\\bwhsec_[A-Za-z0-9]{24,}\\b",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "Generic long hex secret assignment",
        "regex": "(?i)(?:token|secret|key|password|passwd|pwd)[\\s=:\\\"']+[0-9a-fA-F]{32,}",
        "confidence": "Medium",
        "validate_luhn": false
      }
    ]
  },
  {
    "rule_code": "PCI_AUTH_0002",
    "description": "Detection of passwords and credentials in plaintext (URLs, assignments, Basic Auth, env dumps).",
    "mitigation": "Passwords must never appear in logs, source, or tickets. Enforce structured logging with denylist field names (password, passwd, pwd, secret). Rotate any leaked credential. PCI DSS 4.0 Req. 8.3.2 / 8.6.1.",
    "patterns": [
      {
        "name": "Password in URL query string",
        "regex": "(?i)[?&](?:password|passwd|pwd|pass|secret)=([^&\\s\\\"']{4,})",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Password field assignment",
        "regex": "(?i)\\b(?:password|passwd|pwd)\\b[\\s=:\\\"']+([^\\s\\\"',;]{6,})",
        "confidence": "Medium",
        "validate_luhn": false
      },
      {
        "name": "HTTP(S) Basic Auth embedded in URL",
        "regex": "(?i)https?://[^:@/\\s]+:[^@/\\s]+@[^\\s\\\"']+",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": "Database / broker URL with embedded credentials",
        "regex": "(?i)\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|rediss|amqp|amqps|mssql|sqlserver|oracle|ftp|sftp|smtp|smtps)://[^\\s\\\"']*:[^\\s\\\"']+@[^\\s\\\"']+",
        "confidence": "Critical",
        "validate_luhn": false
      },
      {
        "name": "JDBC URL (often carries user/password)",
        "regex": "(?i)\\bjdbc:(?:mysql|postgresql|oracle|sqlserver|mariadb):[^\\s\\\"']+",
        "confidence": "High",
        "validate_luhn": false
      },
      {
        "name": ".env / export of SECRET/PASSWORD/TOKEN/API_KEY",
        "regex": "(?i)\\b(?:export\\s+)?[A-Z][A-Z0-9_]*(?:SECRET|PASSWORD|TOKEN|API[_-]?KEY|PRIVATE[_-]?KEY)[A-Z0-9_]*\\s*=\\s*\\S+",
        "confidence": "High",
        "validate_luhn": false
      }
    ]
  }
]
